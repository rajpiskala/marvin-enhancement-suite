{
  "name": "marvin-enhancement-suite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fix stubborn Amazing Marvin browser bugs and add practical, opt-in workflow upgrades.",
  "author": "Raj Piskala",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajpiskala/marvin-enhancement-suite.git"
  },
  "bugs": {
    "url": "https://github.com/rajpiskala/marvin-enhancement-suite/issues"
  },
  "homepage": "https://github.com/rajpiskala/marvin-enhancement-suite#readme",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "clean": "wxt clean",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:all": "npm run build && npm run build:firefox",
    "build-for-amo": "npm run clean && npm run icons && npm run typecheck && npm run build:all && npm run lint:firefox && npm run zip:chrome && npm run zip:firefox && npm run verify:release",
    "check": "npm run typecheck && npm run test:source && npm run build:all && npm run lint:firefox && npm run test:build",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "icons": "tsx tools/generate-icons.ts",
    "lint:firefox": "tsx tools/run-web-ext.ts lint --source-dir .output/firefox-mv2 --warnings-as-errors",
    "marketplace:prepare": "npm run release && tsx tools/prepare-marketplace.ts",
    "release": "npm run clean && npm run icons && npm run check && npm run zip:chrome && npm run zip:firefox && npm run verify:release",
    "submit": "tsx tools/submit-stores.ts",
    "submit:dry-run": "tsx tools/submit-stores.ts --dry-run",
    "test": "npm run test:source",
    "test:source": "vitest run --exclude tests/build-manifest.test.ts",
    "test:build": "vitest run tests/build-manifest.test.ts",
    "postinstall": "wxt prepare",
    "preview:popup": "tsx tools/preview-server.ts",
    "typecheck": "wxt prepare && tsc --noEmit",
    "verify:release": "tsx tools/verify-release.ts",
    "version:set": "tsx tools/set-version.ts",
    "zip:chrome": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --sources"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.1",
    "@types/yauzl": "^3.4.0",
    "rollup": "^4.63.3",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "web-ext": "10.6.0",
    "wxt": "^0.21.4",
    "yauzl": "^3.4.0"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "^5.3.0"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
